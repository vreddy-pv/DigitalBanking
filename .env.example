# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=digital_banking

# Auth Service
JWT_SECRET=my-super-secret-key-for-jwt-tokens-please-change-in-production-minimum-256-bits
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Database URLs
AUTH_DB_URL=jdbc:postgresql://postgres:5432/auth_db
ACCOUNT_DB_URL=jdbc:postgresql://postgres:5432/account_db
TRANSACTION_DB_URL=jdbc:postgresql://postgres:5432/transaction_db
LEDGER_DB_URL=jdbc:postgresql://postgres:5432/ledger_db

# Server Ports
AUTH_SERVICE_PORT=8001
ACCOUNT_SERVICE_PORT=8002
TRANSACTION_SERVICE_PORT=8003
LEDGER_SERVICE_PORT=8004
API_GATEWAY_PORT=8000

# Application
ENV=dev
APP_VERSION=2.0.0
ANTHROPIC_API_KEY=sk-ant-api03-...

# Datadog APM
# Get your API key from https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=<your-datadog-api-key>
DD_SITE=datadoghq.com
# Set to "true" to enable Datadog tracing across all services
DD_TRACE_ENABLED=false

# LangFuse (AI Observability)
# Create a project at http://localhost:3001 (self-hosted) to get keys
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Generate: openssl rand -hex 32
LANGFUSE_DB_PASSWORD=change-me-strong-password
# Generate: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret
